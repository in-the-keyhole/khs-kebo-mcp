# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kebo_mcp

# Google Drive (service account)
# Place your service account JSON key at credentials/service-account.json
# The service account needs Viewer access to the target Drive folder or Shared Drive
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./credentials/service-account.json
# Optional: restrict Drive search to a specific folder ID
GOOGLE_DRIVE_FOLDER_ID=

# Optional: Google Drive file ID of your SOW template (used to improve extraction prompts)
SCOPE_OF_WORK_TEMPLATE_FILE_ID=

# Local model paths — downloaded automatically from HuggingFace on first run
# Models are cached in ./models/ (gitignored, ~3.7GB total)

# Embedding model (1024 dims, ~1.2GB)
EMBEDDING_HF_REPO=mixedbread-ai/mxbai-embed-large-v1-GGUF
EMBEDDING_HF_FILE=mxbai-embed-large-v1-f16.gguf

# LLM for redaction + structured summary generation (~2.5GB)
LLM_HF_REPO=bartowski/Phi-4-mini-instruct-GGUF
LLM_HF_FILE=Phi-4-mini-instruct-Q4_K_M.gguf
