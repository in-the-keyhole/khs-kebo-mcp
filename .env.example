# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kebo_mcp

# Google Drive (service account)
# Place your service account JSON key anywhere inside credentials/ (gitignored)
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./credentials/your-key-file.json
# Optional: restrict Drive search to a specific folder ID
GOOGLE_DRIVE_FOLDER_ID=

# Optional: Google Drive file ID of your Keyhole SOW template
# Used to improve summarization prompts with section-aware context
SCOPE_OF_WORK_TEMPLATE_FILE_ID=

# Local model paths — downloaded automatically from HuggingFace on first run
# Models are cached in ./models/ (gitignored, ~3.7GB total)
# These defaults work out of the box; only override if you want a different model.

# Embedding model (1024 dims, ~1.2GB)
EMBEDDING_HF_REPO=ChristianAzinn/mxbai-embed-large-v1-gguf
EMBEDDING_HF_FILE=mxbai-embed-large-v1_fp16.gguf

# LLM for redaction + structured summary generation (~2.5GB)
LLM_HF_REPO=bartowski/microsoft_Phi-4-mini-instruct-GGUF
LLM_HF_FILE=microsoft_Phi-4-mini-instruct-Q4_K_M.gguf
